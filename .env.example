# --- LLM (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# --- Web Search (Tavily) ---
TAVILY_API_KEY=your-tavily-api-key

# --- Email (SMTP / Gmail App Password) ---
EMAIL_SENDER=you@gmail.com
EMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_RECIPIENT=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Agent Behaviour ---
TARGET_ROLES=Backend Engineer, Machine Learning Engineer, Full Stack Developer
# Comma/semicolon-separated locations. Each entry expands to a regional signal set
# (e.g. "Kuala Lumpur" also matches Petaling Jaya/Selangor/Cyberjaya; "Penang" also
# matches Bayan Lepas/Kulim). Add "Remote" only if remote roles should be kept.
TARGET_LOCATIONS=Kuala Lumpur, Malaysia; Penang, Malaysia
MATCH_THRESHOLD=70
MAX_RESULTS_PER_QUERY=5

# --- Private resume (never committed) ---
# Option A: paste the resume as a multi-line value in the RESUME_TEXT secret.
# Option B: base64 it (one line, survives any quoting) and use RESUME_B64:
#   Windows PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("resume.txt"))
#   macOS/Linux:        base64 -w0 resume.txt
# RESUME_TEXT=Your Name | City | you@example.com ...
# RESUME_B64WW91ciBOYW1lIHwgQ2l0eSB8IHlvdUBleGFtcGxlLmNvbSAuLi4=
